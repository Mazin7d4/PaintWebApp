{
  "name": "paint-studio",
  "version": "2.0.0",
  "description": "Paint Studio CLI — create, check, and render agent-authored animations to PNG/GIF",
  "type": "module",
  "bin": {
    "paint-studio": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/bin.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.68",
    "@paint-studio/core": "2.0.0",
    "commander": "^13.1.0",
    "gifenc": "^1.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
