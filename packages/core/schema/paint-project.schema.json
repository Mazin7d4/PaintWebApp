{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mazin7d4.github.io/PaintWebApp/schemas/paint-project.schema.json",
  "title": "PaintStudioProject",
  "description": "Paint Studio v2 project file — agent-friendly animation document",
  "type": "object",
  "required": ["version", "name", "width", "height", "fps", "background", "palette", "layers", "frames"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 2 },
    "name": { "type": "string", "minLength": 1 },
    "width": { "type": "integer", "minimum": 1, "maximum": 8192 },
    "height": { "type": "integer", "minimum": 1, "maximum": 8192 },
    "fps": { "type": "number", "minimum": 1, "maximum": 120 },
    "background": { "type": "string" },
    "style": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "enum": ["flat-vector", "inked-cartoon", "pixel-art", "painterly", "neon"]
        },
        "palette": { "type": "array", "items": { "type": "string" } }
      }
    },
    "palette": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "hex"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "hex": { "type": "string" }
        }
      }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "visible", "opacity", "blendMode", "objects"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "visible": { "type": "boolean" },
          "locked": { "type": "boolean" },
          "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
          "blendMode": { "type": "string" },
          "objects": { "type": "array", "items": { "type": "object" } }
        }
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "duration"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "duration": { "type": "number", "minimum": 1 },
          "label": { "type": "string" }
        }
      }
    },
    "camera": {
      "type": "object",
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "zoom": { "type": "number" },
        "rotation": { "type": "number" }
      }
    },
    "cameraKeyframes": { "type": "array", "items": { "type": "object" } },
    "meta": { "type": "object" }
  }
}
